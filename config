[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[lfs]
	repositoryformatversion = 0
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[remote "origin"]
	url = https://github.com/raftazana/lobbyvulnus.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[lfs "https://github.com/raftazana/lobbyvulnus.git/info/lfs"]
	access = basic
[branch "main"]
	remote = origin
	merge = refs/heads/main
